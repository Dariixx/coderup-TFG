---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/layout/Navbar.astro";
import Footer from "../../components/layout/Footer.astro";
import BackToTop from "../../components/react/BackToTop.tsx";
import LiveCourseDetail from "../../components/react/LiveCourseDetail.tsx";
import { getCourseBySlug, getCourses } from "../../lib/content";

export async function getStaticPaths() {
  const cursos = await getCourses();

  return cursos.map((curso) => ({
    params: { slug: curso.slug },
  }));
}

const slug = Astro.params.slug ?? "";
const curso = await getCourseBySlug(slug);
const allCourses = await getCourses();
const relatedCursos = curso ? allCourses.filter((item) => item.slug !== curso.slug).slice(0, 3) : [];
---

<BaseLayout
  title={curso ? curso.seo.metaTitle : "Detalle de curso | CoderUp"}
  description={curso ? curso.seo.metaDescription : "Detalle actualizado desde el catálogo real de CoderUp."}
  canonical={curso ? `/cursos/${curso.slug}` : "/cursos"}
>
  <Navbar />
  <BackToTop client:load />
  <LiveCourseDetail client:load slug={slug} initialCourse={curso} initialRelated={relatedCursos} />
  <Footer />
</BaseLayout>
