---
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import BackToTop from "../components/react/BackToTop.tsx";
import ContactForm from "../components/react/ContactForm.tsx";
---

<BaseLayout title="Contacto | CoderUp">
  <Navbar />

  <section class="pt-32 pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="text-center mb-16">
        <span class="text-[#00FF66] text-sm font-semibold uppercase tracking-widest">Contacto</span>
        <h1 class="text-4xl md:text-5xl font-bold text-white mt-3 mb-4">¿Hablamos?</h1>
        <p class="text-[#888] text-lg max-w-2xl mx-auto">
          Escríbenos si necesitas consultar algo sobre el catálogo, tu cuenta o el funcionamiento de la plataforma.
        </p>
      </div>

      <div class="grid lg:grid-cols-2 gap-12">

        <!-- INFO DE CONTACTO -->
        <div class="space-y-8">
          <div class="bg-[#1A1A1A] border border-[#2A2A2A] rounded-2xl p-8 space-y-8">
            
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-[#00FF66]/10 rounded-xl flex items-center justify-center shrink-0">
                <Icon name="lucide:mail" class="w-6 h-6 text-[#00FF66]" />
              </div>
              <div>
                <h3 class="text-white font-semibold mb-1">Email</h3>
                <p class="text-[#888] text-sm">Canal principal de contacto</p>
                <a href="mailto:hola@coderup-tfg.vercel.app" class="text-[#00FF66] text-sm hover:underline">hola@coderup-tfg.vercel.app</a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-[#00FF66]/10 rounded-xl flex items-center justify-center shrink-0">
                <Icon name="lucide:message-circle" class="w-6 h-6 text-[#00FF66]" />
              </div>
              <div>
                <h3 class="text-white font-semibold mb-1">Formulario</h3>
                <p class="text-[#888] text-sm">Envía tu mensaje desde esta página.</p>
                <p class="text-[#00FF66] text-sm">Se registra como consulta de contacto</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-[#00FF66]/10 rounded-xl flex items-center justify-center shrink-0">
                <Icon name="lucide:map-pin" class="w-6 h-6 text-[#00FF66]" />
              </div>
              <div>
                <h3 class="text-white font-semibold mb-1">Ubicación</h3>
                <p class="text-[#888] text-sm">Proyecto web desplegado online</p>
                <p class="text-[#888] text-sm">Frontend en Vercel y backend en Railway</p>
              </div>
            </div>

          </div>

          <!-- FAQ rápido -->
          <div class="bg-[#1A1A1A] border border-[#2A2A2A] rounded-2xl p-8">
            <h3 class="text-white font-semibold mb-4">Consultas habituales</h3>
            <div class="space-y-4">
              <div class="flex items-start gap-3">
                <Icon name="lucide:help-circle" class="w-5 h-5 text-[#00FF66] shrink-0 mt-0.5" />
                <div>
                  <p class="text-white text-sm font-medium">¿Dónde veo los cursos?</p>
                  <p class="text-[#888] text-xs mt-1">En la página de catálogo puedes filtrar por categoría y nivel.</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <Icon name="lucide:help-circle" class="w-5 h-5 text-[#00FF66] shrink-0 mt-0.5" />
                <div>
                  <p class="text-white text-sm font-medium">¿Dónde aparecen mis compras?</p>
                  <p class="text-[#888] text-xs mt-1">Los pedidos completados aparecen en tu zona de cuenta.</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <Icon name="lucide:help-circle" class="w-5 h-5 text-[#00FF66] shrink-0 mt-0.5" />
                <div>
                  <p class="text-white text-sm font-medium">¿Qué información tiene cada curso?</p>
                  <p class="text-[#888] text-xs mt-1">Nivel, duración, lecciones, requisitos, temario, instructor, valoración y precio.</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- FORMULARIO -->
        <div class="bg-[#1A1A1A] border border-[#2A2A2A] rounded-2xl p-8">
          <h2 class="text-2xl font-bold text-white mb-2">Envíanos un mensaje</h2>
          <p class="text-[#888] text-sm mb-8">Rellena el formulario con tu consulta.</p>
          <ContactForm client:load />
        </div>

      </div>

    </div>
  </section>

  <Footer />
  <BackToTop client:load />
</BaseLayout>
