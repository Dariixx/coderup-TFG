---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/layout/Navbar.astro";
import Footer from "../../components/layout/Footer.astro";
import AdminPanel from "../../components/react/admin/AdminPanel";
---

<BaseLayout title="Admin | CoderUp" description="Panel privado de administracion de CoderUp." canonical="/admin" robots="noindex,nofollow">
  <Navbar />
  <main class="flex-1 pt-32 pb-20">
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <AdminPanel client:load />
    </section>
  </main>
  <Footer />
</BaseLayout>
