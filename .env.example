# CoderUp environment example
# Copy the variables you need to Vercel, Railway or a local .env file.

# Frontend (Vercel / Astro)
# Public backend URL, without trailing slash.
PUBLIC_API_URL=https://coderup-tfg-production.up.railway.app

# Backend (Railway / PHP)
APP_ENV=production
FRONTEND_URL=https://coderup-tfg.vercel.app
RESET_PASSWORD_URL=https://coderup-tfg.vercel.app/reset-password

# MySQL (Railway plugin or local database)
DB_HOST=railway.internal
DB_PORT=3306
DB_NAME=railway
DB_USER=root
DB_PASS=replace_with_railway_mysql_password

# Auth token signing key.
# Use a long random value in Railway.
AUTH_SECRET=replace_with_a_long_random_secret

# Password recovery email (Brevo API)
BREVO_API_KEY=replace_with_brevo_api_key
SMTP_FROM_EMAIL=no-reply@coderup-tfg.vercel.app
SMTP_FROM_NAME=CoderUp

# Optional development helper.
# When true, forgot-password can return the reset URL if email delivery fails.
RESET_EMAIL_DEBUG=false
